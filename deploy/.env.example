# =============================================================================
# PetroChina GPP Inventory - Self-Hosting Configuration
# -----------------------------------------------------------------------------
# Copy this file to ".env" (in the same "deploy" folder) and edit the values
# below. This single file is the ONLY place you configure the deployment.
# No real secrets are stored here - these are safe placeholder defaults.
# =============================================================================

# -- Internal hostname -------------------------------------------------------
# The DNS name your staff will type in the browser. Must resolve on your
# intranet (company DNS or each client's hosts file) to THIS server's IP.
# The self-signed HTTPS certificate is generated for exactly this name.
APP_HOSTNAME=inventory.yourcompany.local

# -- Public web address ------------------------------------------------------
# Where the single-page app sends its API calls. Leave EMPTY for the normal
# single-server setup: the app then calls "/api" on the same origin it was
# loaded from (recommended). Only set this to a full URL (e.g.
# https://inventory.yourcompany.local) if the backend is served elsewhere.
REACT_APP_BACKEND_URL=

# -- Allowed cross-origin callers --------------------------------------------
# Browsers enforce this. For the same-origin setup above it is not used, but
# set it to your HTTPS address for safety. Comma-separated; "*" allows all.
CORS_ORIGINS=https://inventory.yourcompany.local

# -- Database ----------------------------------------------------------------
# The MongoDB database name used by the application. The database server runs
# inside the stack on an internal network and is NOT exposed on the host.
DB_NAME=gpp_inventory

# Pinned database image version (shipped prebuilt in the image bundle).
MONGO_IMAGE_TAG=7.0

# -- Ports (published on the server) -----------------------------------------
# 80 redirects to 443. The database port is intentionally NOT published.
HTTP_PORT=80
HTTPS_PORT=443

# -- Release version (image tags) --------------------------------------------
# Keep in sync with the tested release. Used to tag/select the built images.
APP_VERSION=1.0.0

# -- Timezone ----------------------------------------------------------------
TZ=UTC
